#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	config_load cowrt
	local listen www
	config_get listen main listen '0.0.0.0:80'
	config_get www main www '/usr/share/cowrt/www'

	procd_open_instance
	procd_set_param command /usr/sbin/cowrtd --listen "$listen" --www "$www"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
